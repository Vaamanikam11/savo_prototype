# mock = offline keyword heuristic (NOT an AI model). Use openai or anthropic for real scoring.
LLM_PROVIDER=mock

# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Protect a shared link (set these on the server, never in frontend code)
ACCESS_CODE=change-me
ADMIN_TOKEN=change-me-too
MAX_SESSIONS_PER_DAY=40
